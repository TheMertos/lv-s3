ADMIN_PORT=9001
S3_PORT=9000
# Production: put STORAGE_ROOT (and SQLite DATABASE_PATH) on an encrypted volume.
STORAGE_ROOT=./data/storage
DATABASE_PATH=./data/app.db
# Optional Postgres (overrides DATABASE_PATH when set). Production: encrypt the Postgres data dir volume.
# DATABASE_URL=postgres://lvs3:lvs3@localhost:5432/lvs3
TYPEORM_SYNC=true
# Production / Docker: TYPEORM_SYNC=false. Migrations always run on startup (before synchronize).
JWT_ACCESS_SECRET=change-me-access-min-32-chars-please!!
# Service-account secrets (GCM) + per-bucket object-at-rest keys (HKDF) when a bucket is created with encryptAtRest.
# Production: secrets manager; never commit the real key; keep key backups separate from data backups.
MASTER_ENCRYPTION_KEY=64-hex-or-any-long-secret-for-aes
# Development only: production ignores these (S3 uses admin / service-account keys in the DB).
S3_ROOT_ACCESS_KEY=root
S3_ROOT_SECRET_KEY=rootsecret12345678
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=ChangeMe12345678
# Production: set TRUST_PROXY=1 (or hop count) behind reverse proxy for correct client IP / lockout
TRUST_PROXY=
# Production: Swagger off by default; set ADMIN_SWAGGER=true to enable explicitly
ADMIN_SWAGGER=
# S3 SigV4 request timestamp max skew (seconds, default 900 = 15 min)
S3_SIGV4_MAX_SKEW_SEC=900
S3_PRESIGN_MAX_EXPIRES_SEC=604800
# S3 API rate limit (per IP)
S3_THROTTLE_LIMIT=300
S3_THROTTLE_TTL_MS=60000
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_LOCKOUT_MINUTES=15
ADMIN_LOGIN_WINDOW_MINUTES=15
# Admin API rate limit (global, per IP)
ADMIN_THROTTLE_LIMIT=120
ADMIN_THROTTLE_TTL_MS=60000
# Admin multipart upload: max 100 MiB per file; magic-byte validation (executables blocked)
# Optional malware scan before object publish. Default off = no scan.
MALWARE_SCANNER=off
# MALWARE_SCANNER=clamav
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310
# MALWARE_SCANNER=webhook
# MALWARE_WEBHOOK_URL=http://127.0.0.1:8080/scan
# MALWARE_WEBHOOK_TIMEOUT_MS=30000
# Lifecycle runner (automatic background execution)
LIFECYCLE_RUNNER_ENABLED=true
LIFECYCLE_RUNNER_INTERVAL_MS=60000
# S3 port: redirect browser (HTML Accept) to the admin UI (no XML in the browser tab).
BROWSER_REDIRECT_URL=http://localhost:9001
CORS_ADMIN_ORIGIN=http://localhost:5173
CORS_S3_ORIGIN=http://localhost:5173
# S3 upload limits (streaming): single PUT max; multipart part bounds
S3_MAX_SINGLE_PUT_BYTES=104857600
S3_MULTIPART_MIN_PART_BYTES=8388608
S3_MULTIPART_MAX_PART_BYTES=67108864
# Optional shared rate-limit / lockout backend. If unset, use DB table.
# REDIS_URL=redis://127.0.0.1:6379/0
# REDIS_KEY_PREFIX=lv-s3:
