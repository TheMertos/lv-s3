# Optional: full admin API URL (overrides proxy / port defaults).
# VITE_ADMIN_API=http://127.0.0.1:9001
#
# Preferred for local Vite: same-origin proxy so HttpOnly refresh cookie (path=/auth) works.
VITE_ADMIN_PROXY=1
# VITE_ADMIN_PROXY_TARGET=http://127.0.0.1:9001
# VITE_ADMIN_PORT=9001
#
# Without proxy, browser calls http://127.0.0.1:9001 directly (needs CORS_ADMIN_ORIGIN=http://localhost:5173).
VITE_S3_ENDPOINT=http://localhost:9000
VITE_S3_REGION=us-east-1
