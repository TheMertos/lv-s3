# Docker Compose (repo root): cp .env.docker.example .env
# Used by docker-compose.yml (NODE_ENV=production). Do NOT copy backend/.env.example verbatim —
# it includes dev-only S3_ROOT_* keys that validateEnv rejects in production.

# Required — use strong random values (min 32 chars)
JWT_ACCESS_SECRET=replace-with-random-access-secret-min-32-chars
MASTER_ENCRYPTION_KEY=replace-with-random-64-char-or-longer-master-key-value

# First admin login (created on empty DB)
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=ChangeThisStrongPassword123!

# Optional publish ports (host → container)
# S3_PUBLISH_PORT=9000
# ADMIN_PUBLISH_PORT=9001
# POSTGRES_PUBLISH_PORT=5432
# REDIS_PUBLISH_PORT=6379
# CLAMAV_PUBLISH_PORT=3310

# Optional Postgres (uncomment DATABASE_URL in docker-compose.yml; profile postgres)
# POSTGRES_PASSWORD=lvs3

# Browser / CORS (defaults match localhost compose)
# BROWSER_REDIRECT_URL=http://localhost:9001
# CORS_ADMIN_ORIGIN=http://localhost:9001
# CORS_S3_ORIGIN=http://localhost:3000

# Lifecycle background runner
# LIFECYCLE_RUNNER_ENABLED=true
# LIFECYCLE_RUNNER_INTERVAL_MS=60000

# Optional malware scan before publish (default off). For ClamAV Compose profile:
# docker compose --profile clamav up -d
# then set MALWARE_SCANNER / CLAMAV_* on api (see docker-compose.yml comments).
# MALWARE_SCANNER=clamav
# CLAMAV_HOST=clamav
# CLAMAV_PORT=3310
# MALWARE_SCANNER=webhook
# MALWARE_WEBHOOK_URL=http://scanner:8080/scan
# MALWARE_WEBHOOK_TIMEOUT_MS=30000

# Behind reverse proxy only
# TRUST_PROXY=1
