# After: docker compose up -d (from repo root)
# Tests: private + public bucket, spec/cases/ upload+download, presigned URLs, regression
ADMIN_URL=http://localhost:9001
# Must match root .env ADMIN_BOOTSTRAP_USERNAME (default admin)
S3_URL=http://localhost:9000
REGION=us-east-1
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeThisStrongPassword123!
# Optional: if set, skips login and uses root for S3-only checks
# Production API ignores S3_ROOT_*; E2E uses /auth/s3-credentials after login.
